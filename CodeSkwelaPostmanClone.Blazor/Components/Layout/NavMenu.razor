@using CodeSkwelaPostmanClone.Blazor.Components.Shared
@using CodeSkwelaPostmanClone.Blazor.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject RequestsNavigationMenuState RequestsNavigationMenuState
@inject RequestDetailsState RequestDetailsState

<MudNavMenu>
    <MudNavGroup Title="Requests" Expanded="true" Icon="@Icons.Material.Filled.List">
        @foreach (var request in _requests)
        {
            <MudNavLink OnClick="@(() => LoadRequest(request.Id))">@request.Name</MudNavLink>
        }
    </MudNavGroup>
</MudNavMenu>

@code{
    List<Core.Entities.RequestSettings> _requests = new List<Core.Entities.RequestSettings>();
    
    protected override async Task OnInitializedAsync()
    {
        RequestDetailsState.OnRequestDeleted += (requestId) =>
        {
            var existingRequest = _requests.FirstOrDefault(r => r.Id == requestId);
            if (existingRequest is not null)
            {
                _requests.Remove(existingRequest);
            }

            StateHasChanged();
        };

        await LoadRequests();
    }

    private async Task LoadRequests()
    {
        using (var context = DbContextFactory.CreateDbContext())
        {
            _requests = await context.RequestSettings.ToListAsync();
        }
    }

    private void LoadRequest(int id)
    {
        RequestsNavigationMenuState.SelectedRequest = id;
    }
}