@page "/workflows/basic"
@using CodeSkwelaPostmanClone.Blazor.Components.Shared
@using CodeSkwelaPostmanClone.Blazor.Infrastructure.Data
@using CodeSkwelaPostmanClone.Blazor.Shared
@using CodeSkwelaPostmanClone.Blazor.Shared.WorkflowActions
@using Microsoft.EntityFrameworkCore
@using Shared = CodeSkwelaPostmanClone.Blazor.Shared
@inject IHttpClientFactory HttpClientFactory
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject ISnackbar Snackbar
@inject IScrollManager ScrollManager

<MudPaper Class="ma-2">
    <MudToolBar>
        <MudMenu Icon="@Icons.Material.Filled.Add" AriaLabel="Open user menu">
            <MudMenuItem Label="Request" OnClick="AddRequest" />
            <MudDivider/>
            <MudMenuItem Label="Repeat" OnClick="AddRepeat" />
            <MudMenuItem Label="Delay" OnClick="AddDelay" />
        </MudMenu>
        <MudIconButton OnClick="RunWorkflow" Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Success" />        
    </MudToolBar>
</MudPaper>
<MudPaper Class="ma-2">
    <MudGrid Class="flex-grow-1" Style="height: 100%;max-height: calc(100vh - 64px);" Spacing="0">
        <MudItem xs="6" sm="6" md="6" lg="6" Class="d-flex flex-column flex-grow-1 overflow-hidden" Style="height: 100%;">
            <MudStack Spacing="0" StretchItems="StretchItems.All">
                @if(_workflow is not null)
                {
                    foreach (var action in _workflow)
                    {
                        <MudPaper Square="true" Outlined="true" Class="pa-1" @key="action">
                        @if (action is Shared.WorkflowActions.DelayAction delayAction)
                        {
                            <DelayAction Action="delayAction" OnResponseOutput="DisplayResponse" OnDelete="DeleteAction" />
                        }
                        else if (action is Shared.WorkflowActions.RepeatAction repeatAction)
                        {
                            <RepeatAction Action="repeatAction" OnResponseOutput="DisplayResponse" OnDelete="DeleteAction" />
                        }
                        else
                        {
                            <WorkflowAction Action="action" OnResponseOutput="DisplayResponse" OnDelete="DeleteAction" />
                        }
                        </MudPaper>
                    }
                }                
            </MudStack>
        </MudItem>
        <MudItem xs="6" sm="6" md="6" lg="6" Class="d-flex flex-column flex-grow-1" style="height: 100%;" id="console-output-1">
            <MudStack Spacing="0" StretchItems="StretchItems.All" Class="flex-grow-1 overflow-hidden" Style="height: 100%;">
                <MudPaper Square="true" Outlined="true"  Class="flex-grow-1 pa-4 overflow-y-auto" Style="height: 100%;" id="console-output-2">
                    <MudStack Row StretchItems="StretchItems.Start">
                        <MudText>Console output</MudText>
                        <MudButton OnClick="ClearConsole">Clear</MudButton>
                    </MudStack>
                    <MudStack Class="pa-4 font-monospace" Style="background-color: #0c0c0c; color: #cccccc; overflow-y: auto; border: 1px solid #333333;">
                    @foreach (var response in _responses)
                    {
                        <MudText Typo="Typo.body2" Class="font-monospace text-justify" Style="color: #cccccc;">@response</MudText>
                    }
                    </MudStack>
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>
<MudMessageBox @ref="_mudMessageBox" Title="Select Request" CancelText="Cancel">
    <MessageContent>
        <MudText>Select a request and click Add to proceed.</MudText>
        <MudList @bind-SelectedValue="_selectedRequest">
        @foreach(var request in _requests)
        {
            <MudListItem Value="request">@request.Name</MudListItem>
        }
        </MudList>
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary">Add</MudButton>
    </YesButton>
</MudMessageBox>

@code {
    MudMessageBox _mudMessageBox;
    Core.Entities.RequestSettings _selectedRequest;
    List<Core.Entities.RequestSettings> _requests = new List<Core.Entities.RequestSettings>();
    Shared.Workflow _workflow = new Shared.Workflow();
    List<string> _responses = new List<string>();

    private async Task LoadRequests()
    {
        using (var context = DbContextFactory.CreateDbContext())
        {
            _requests = await context.RequestSettings.ToListAsync();
        }
    }

    private async Task AddRequest()
    {
        await LoadRequests();

        var result = await _mudMessageBox.ShowAsync();

        if(result.HasValue && result.Value)
        {
            var requestWorkflowAction = new RequestAction(_selectedRequest.Name, _selectedRequest, HttpClientFactory.CreateClient());
            _workflow.AddAction(requestWorkflowAction);
        }
    }

    private async Task RunWorkflow()
    {
        await _workflow.Run();
    }

    private async Task DisplayResponse(string? response)
    {
        _responses.Add(response);
        //await ScrollManager.ScrollToBottomAsync("#console-output-2");
    }

    private async Task AddDelay()
    {
        var delayAction = new Shared.WorkflowActions.DelayAction($"Delay");
        _workflow.AddAction(delayAction);
    }

    private async Task AddRepeat()
    {
        var repeatAction = new Shared.WorkflowActions.RepeatAction("Repeat", 1);
        _workflow.AddAction(repeatAction);
    }

    private void ClearConsole()
    {
        _responses.Clear();
    }

    private void DeleteAction(Shared.WorkflowAction action)
    {
        _workflow.Actions.Remove(action);        
    }
}
