@page "/workflows"
@using CodeSkwelaPostmanClone.Blazor.Infrastructure.Data
@using CodeSkwelaPostmanClone.Blazor.Shared
@using Microsoft.EntityFrameworkCore
@inject HttpClient HttpClient
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject ISnackbar Snackbar

<MudPaper Class="mt-2 mb-2">
    <MudToolBar>
        <MudMenu Icon="@Icons.Material.Filled.Add" AriaLabel="Open user menu">
            <MudMenuItem Label="Request" OnClick="AddRequest" />
            <MudDivider/>
            <MudMenuItem Label="Repeat" />
            <MudMenuItem Label="Delay" />
        </MudMenu>
        <MudIconButton OnClick="RunWorkflow" Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Success" />        
    </MudToolBar>
</MudPaper>
<MudPaper>
    <MudStack>
        @foreach (var selectedRequest in _actionRequests)
        {
            <MudPaper Square="true" Class="pa-1">
                <MudText>@selectedRequest.Name</MudText>
            </MudPaper>
        }
    </MudStack>
</MudPaper>
<MudMessageBox @ref="_mudMessageBox" Title="Select Request" CancelText="Cancel">
    <MessageContent>
        <MudText>Select a request and click Add to proceed.</MudText>
        <MudList @bind-SelectedValue="_selectedRequest">
        @foreach(var request in _requests)
        {
            <MudListItem Value="request">@request.Name</MudListItem>
        }
        </MudList>
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary">Add</MudButton>
    </YesButton>
</MudMessageBox>

@code {
    MudMessageBox _mudMessageBox;
    Core.Entities.RequestSettings _selectedRequest;
    List<Core.Entities.RequestSettings> _requests = new List<Core.Entities.RequestSettings>();
    List<Core.Entities.RequestSettings> _actionRequests = new List<Core.Entities.RequestSettings>();

    protected override async Task OnInitializedAsync()
    {
        await LoadRequests();
    }

    private async Task LoadRequests()
    {
        using (var context = DbContextFactory.CreateDbContext())
        {
            _requests = await context.RequestSettings.ToListAsync();
        }
    }

    private async Task AddRequest()
    {
        var result = await _mudMessageBox.ShowAsync();

        if(result.HasValue && result.Value)
        {
            _actionRequests.Add(_selectedRequest);
        }
    }

    private async Task RunWorkflow()
    {
        await RunRequest(_actionRequests.FirstOrDefault()!);
    }

    private async Task RunRequest(Core.Entities.RequestSettings? requestSettings)
    {
        if (requestSettings is null) return;

        if (string.IsNullOrWhiteSpace(requestSettings.Url))
        {
            Snackbar.Add("Url is required");
            return;
        }

        //_isRequesting = true;

        try
        {
            var request = CreateRequest(requestSettings);
            var response = await HttpClient.SendAsync(request);
            var responseContent = await response.Content.ReadAsStringAsync();
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private HttpRequestMessage CreateRequest(Core.Entities.RequestSettings requestSettings)
    {
        var request = new HttpRequestMessage
        {
            Method = new HttpMethod(requestSettings.Verb),
            RequestUri = new Uri(requestSettings.Url)
        };

        if (!string.IsNullOrWhiteSpace(requestSettings.Body))
            request.Content = new StringContent(requestSettings.Body);

        request.Headers.Clear();
        var requestHeader = requestSettings.HeaderParameters.Where(x => x.HeaderType == HeaderType.Request).ToList();

        foreach (var header in requestHeader)
            request.Headers.Add(header.Key, header.Value);

        if (request.Content != null) request.Content.Headers.Clear();

        var contentHeaders = requestSettings.HeaderParameters.Where(x => x.HeaderType == HeaderType.Content).ToList();

        foreach (var header in contentHeaders)
            request.Content.Headers.Add(header.Key, header.Value);

        return request;
    }
}
