@page "/"
@using CodeSkwelaPostmanClone.Blazor.Components.Shared
@using CodeSkwelaPostmanClone.Blazor.Infrastructure.Data
@using CodeSkwelaPostmanClone.Blazor.Shared
@using Microsoft.EntityFrameworkCore
@inject ISnackbar Snackbar
@inject HttpClient HttpClient
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>Blazter Api Helper</PageTitle>

<MudDynamicTabs @ref="@_requestTabs" @bind-ActivePanelIndex="@_activeTabIndex"
                AddTab="@AddRequestTab" CloseTab="@CloseRequestTab"
                AddIconToolTip="Add new request" CloseIconToolTip="Close this tab"
                TabPanelsClass="px-2 py-2" Elevation="4" Rounded ApplyEffectsToContainer Class="mt-2">
    @foreach (var request in _requests)
    {
        <MudTabPanel ID="@request.Id" @bind-Text="@request.Name" ShowCloseIcon="@true">
            <RequestDetails RequestSettings="@request" OnNameChanged="@((nameVal) => UpdateRequestName(nameVal))"></RequestDetails>
        </MudTabPanel>
    }
</MudDynamicTabs>

    @code{    
    int _activeTabIndex;
    MudDynamicTabs? _requestTabs;

    protected override async Task OnInitializedAsync()
    {
        await LoadRequests();        
    }

    private List<Core.Entities.RequestSettings> _requests = new List<Core.Entities.RequestSettings>();
    private async Task LoadRequests()
    {
        using (var context = DbContextFactory.CreateDbContext())
        {
            _requests = await context.RequestSettings.ToListAsync();
        }
    }

    private void AddRequestTab()
    {
        var newRequest = new Core.Entities.RequestSettings
        {
            Name = $"Request {_requests.Count + 1}",
            Url = "",
            Verb = "get",
            Body = "",
            HeaderParameters = new List<HeaderParameter>()
        };
        _requests.Add(newRequest);
        _activeTabIndex = _requests.Count - 1;
    }

    private void CloseRequestTab(MudTabPanel panel)
    {
        if (panel.ID is int)
        {
            RemoveTab((int)panel.ID);
        }
    }

    private void RemoveTab(int id)
    {
        var request = _requests.FirstOrDefault(x => x.Id == id);
        _requests.Remove(request);
    }

    private void UpdateRequestName(string nameVal)
    {
        var request = _requests[_activeTabIndex];
        request.Name = nameVal;

        StateHasChanged();
    }
}