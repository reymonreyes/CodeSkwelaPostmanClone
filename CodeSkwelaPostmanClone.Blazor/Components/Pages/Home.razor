@page "/"
@inject ISnackbar Snackbar

<PageTitle>Blazor Postman Clone</PageTitle>

<MudPaper class="pa-2 mt-2">
    <MudGrid>
        <MudItem sm="1" md="1" lg="1">
            <MudSelect @bind-Value="_httpVerb" Variant="Variant.Outlined">
                <MudSelectItem Value="@("get")">GET</MudSelectItem>
                <MudSelectItem Value="@("post")">POST</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem sm="9" md="9" lg="9">
            <MudTextField T="string" Variant="Variant.Outlined"></MudTextField>
        </MudItem>
        <MudItem sm="2" md="2" lg="2">
            <MudButton OnClick="Send" Variant="Variant.Filled" FullWidth="true" Color="Color.Primary" Style="height: 100%;">Send</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code{
    string _httpVerb = "get";
    string _url = "";

    private void Send()
    {
        if (string.IsNullOrWhiteSpace(_url))
        {
            Snackbar.Add("Url is required");
            return;
        }

    }
}