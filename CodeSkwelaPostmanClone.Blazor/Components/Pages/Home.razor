@page "/"
@using CodeSkwelaPostmanClone.Blazor.Components.Shared
@using CodeSkwelaPostmanClone.Blazor.Infrastructure.Data
@using CodeSkwelaPostmanClone.Blazor.Shared
@using Microsoft.EntityFrameworkCore
@inject ISnackbar Snackbar
@inject HttpClient HttpClient
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject RequestsNavigationMenuState RequestsNavigationMenuState
@inject RequestDetailsState RequestDetailsState

<PageTitle>Blazter Api Helper</PageTitle>

<MudDynamicTabs @ref="@_requestTabs" @bind-ActivePanelIndex="@_activeTabIndex"
                AddTab="@AddRequestTab" CloseTab="@CloseRequestTab"
                AddIconToolTip="Add new request" CloseIconToolTip="Close this tab"
                TabPanelsClass="px-2 py-2" Elevation="4" Rounded ApplyEffectsToContainer Class="mt-2">
    @foreach (var request in _requests)
    {
        <MudTabPanel ID="@request.Id" @bind-Text="@request.Name" ShowCloseIcon="@true">
            <RequestDetails RequestSettings="@request" OnNameChanged="@((nameVal) => UpdateRequestName(nameVal))" OnRequestDeleted="DeleteRequest" OnRequestAdded="AddRequest"></RequestDetails>
        </MudTabPanel>
    }
</MudDynamicTabs>

    @code{
    int _activeTabIndex;
    MudDynamicTabs? _requestTabs;

    protected override async Task OnInitializedAsync()
    {
        RequestsNavigationMenuState.OnRequestSelected += HandleSelectedRequest;
        await LoadRequests();        
    }

    private void HandleSelectedRequest(int requestId)
    {
        var requestTabExist = _requestTabs.Panels.FirstOrDefault(x => x.ID is int && (int)x.ID == requestId);

        if (requestTabExist is not null)
            _requestTabs.ActivatePanelAsync((object)requestId).Wait();
        else
        {
            using (var context = DbContextFactory.CreateDbContext())
            {
                var request = context.RequestSettings.FirstOrDefault(x => x.Id == requestId);
                if (request is not null)
                {
                    _requests.Add(request);
                    _activeTabIndex = _requests.Count - 1;
                    StateHasChanged();
                }
            }
        }
    }

    private List<Core.Entities.RequestSettings> _requests = new List<Core.Entities.RequestSettings>();
    private async Task LoadRequests()
    {
        using (var context = DbContextFactory.CreateDbContext())
        {
            _requests = await context.RequestSettings.ToListAsync();
        }
    }

    private void AddRequestTab()
    {
        int requestsCount = 0;

        using (var context = DbContextFactory.CreateDbContext())
        {
            requestsCount = context.RequestSettings.Count();
        }


        var newRequest = new Core.Entities.RequestSettings
        {
            Name = $"Request {requestsCount + 1}",
            Url = "",
            Verb = "get",
            Body = "",
            HeaderParameters = new List<HeaderParameter>()
        };
        _requests.Add(newRequest);
        _activeTabIndex = _requests.Count - 1;
    }

    private void CloseRequestTab(MudTabPanel panel)
    {
        if (panel.ID is int)
        {
            RemoveTab((int)panel.ID);
        }
    }

    private void RemoveTab(int id)
    {
        var request = _requests.FirstOrDefault(x => x.Id == id);
        _requests.Remove(request);
    }

    private void UpdateRequestName(string nameVal)
    {
        var request = _requests[_activeTabIndex];
        request.Name = nameVal;

        StateHasChanged();
    }

    private void DeleteRequest(int requestId)
    {
        RemoveTab(requestId);
        RequestDetailsState.DeleteRequest(requestId);
    }

    private void AddRequest(Core.Entities.RequestSettings request)
    {
        RequestDetailsState.AddRequest(request);
    }
}