@page "/"
@using CodeSkwelaPostmanClone.Blazor.Components.Shared
@using CodeSkwelaPostmanClone.Blazor.Shared
@inject ISnackbar Snackbar
@inject HttpClient HttpClient

<PageTitle>Blazor Postman Clone</PageTitle>

<MudPaper class="pa-2 mt-2">
    <MudGrid>
        <MudItem sm="1" md="1" lg="1">
            <MudSelect @bind-Value="_httpVerb" Variant="Variant.Outlined">
                <MudSelectItem Value="@("get")">GET</MudSelectItem>
                <MudSelectItem Value="@("post")">POST</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem sm="9" md="9" lg="9">
            <MudTextField T="string" Value="_url" ValueChanged="ParseParameters" Variant="Variant.Outlined" Placeholder="Enter URL here"></MudTextField>
        </MudItem>
        <MudItem sm="2" md="2" lg="2">
            <MudButton OnClick="Send" Variant="Variant.Filled" FullWidth="true" Color="Color.Primary" Style="height: 100%;">Send</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>
<MudPaper Elevation="0" class="mt-7">
    <MudGrid>
        <MudItem sm="4" md="4" lg="4">
            <QueryParamsComponent Parameters="_parameters" OnParamDeleted="UpdateQueryString" OnParamAdded="AddParameter" />            
        </MudItem>
        <MudItem sm="4" md="4" lg="4">
            <MudText>Headers</MudText>
            <MudSimpleTable Bordered="true" Dense="true">
                <thead>
                    <tr><th>Key</th><th>Value</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td><MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" /></td>
                        <td><MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" /></td>
                    </tr>
                    <tr>
                        <td><MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" /></td>
                        <td><MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" /></td>
                    </tr>
                    <tr>
                        <td><MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" /></td>
                        <td><MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" /></td>
                    </tr>
                </tbody>
            </MudSimpleTable>
        </MudItem>
        <MudItem sm="4" md="4" lg="4">
            <MudText>Body</MudText>
            <MudTextField T="string" Lines="10" Margin="Margin.Dense" Variant="Variant.Outlined"></MudTextField>
        </MudItem>
    </MudGrid>
</MudPaper>
<MudPaper Elevation="2" class="mt-3">
    <MudText Class="pa-2">Response</MudText>
    <MudGrid class="pa-3">
        <MudItem sm="12" md="12" lg="12">
            <MudText>
                <pre style="white-space: pre-wrap;">
                    <code>
                        @_responseContent
                    </code>
                </pre>
            </MudText>        
        </MudItem>
    </MudGrid>
</MudPaper>

@code{
    string _httpVerb = "get";
    string _url = "";
    string _responseContent = "";
    List<KeyValuePair<string, string>> _parameters = new List<KeyValuePair<string, string>>();

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_url))
        {
            Snackbar.Add("Url is required");
            return;
        }

        switch (_httpVerb)
        {
            case "get":
                _responseContent = await GetRequest();
                break;
            case "post":
                _responseContent = await PostRequest();
                break;
            default:
                break;
        }
    }

    private async Task<string> GetRequest()
    {
        var response = await HttpClient.GetAsync(_url);

        var content = await response.Content.ReadAsStringAsync();

        return content;
    }

    private async Task<string> PostRequest()
    {
        var body = """
            {
              "name": "Apple MacBook Pro 16",
              "data": {
                "year": 2019,
                "price": 1849.99,
                "CPU model": "Intel Core i9",
                "Hard disk size": "1 TB"
              }
            }
            """;

        var request = new HttpRequestMessage
        {
            Method = new HttpMethod("post"),
            RequestUri = new Uri(_url),
            Content = new StringContent(body)
        };

        request.Content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/json");

        var response = await HttpClient.SendAsync(request);

        return await response.Content.ReadAsStringAsync();
    }

    private void ParseParameters(string url)
    {
        _url = url;

        var parser = new UrlParametersParser();

        _parameters = parser.ParseParametersToList(_url);
    }

    private void UpdateQueryString()
    {
        var baseUrl = _url.Substring(0, _url.IndexOf('?') + 1);

        baseUrl += string.Join('&', _parameters.Select(x => $"{x.Key}={x.Value}").ToList());

        _url = baseUrl;
    }

    private void AddParameter(KeyValuePair<string, string> parameter)
    {
        _parameters.Add(parameter);
        UpdateQueryString();
    }
}