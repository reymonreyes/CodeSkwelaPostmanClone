@using CodeSkwelaPostmanClone.Blazor.Shared
<MudText>Query Params</MudText>
<MudSimpleTable Bordered="true" Dense="true">
    <thead>
        <tr><th></th><th>Key</th><th>Value</th></tr>
    </thead>
    <tbody>
        @foreach (var parameter in Parameters)
        {
            <tr>
                <td><MudIconButton OnClick="@(() => DeleteParam(parameter))" Icon="@Icons.Material.Filled.Close" aria-label="delete" Size="Size.Small" /></td>
                <td><MudTextField T="string" ValueChanged="@((key) => UpdateKey(parameter, key))" Value="@parameter.Key" Variant="Variant.Outlined" Margin="Margin.Dense" /></td>
                <td><MudTextField T="string" ValueChanged="@((val) => UpdateValue(parameter, val))" Value="@parameter.Value" Variant="Variant.Outlined" Margin="Margin.Dense" /></td>
            </tr>
        }
        <tr>
            <td><MudIconButton OnClick="@(() => AddParam(_paramKey, _paramValue))" Icon="@Icons.Material.Filled.Check" aria-label="add" Size="Size.Small" /></td>
            <td><MudTextField @ref="_paramKeyText" T="string" Value="_paramKey" ValueChanged="@((key) => AddParam(key, _paramValue))" Variant="Variant.Outlined" Margin="Margin.Dense" /></td>
            <td><MudTextField @ref="_paramValueText" T="string" Value="_paramValue" ValueChanged="@((value) => AddParam(_paramKey, value))" Variant="Variant.Outlined" Margin="Margin.Dense" /></td>
        </tr>
    </tbody>
</MudSimpleTable>

@code {
    private string _paramKey = string.Empty, _paramValue = string.Empty;
    MudTextField<string> _paramKeyText;
    MudTextField<string> _paramValueText;

    [Parameter]
    public List<QueryStringParameter> Parameters { get; set; }

    [Parameter]
    public EventCallback<QueryStringParameter> OnParamDeleted { get; set; }

    [Parameter]
    public EventCallback<QueryStringParameter> OnParamAdded { get; set; }

    [Parameter]
    public EventCallback<QueryStringParameter> OnParamChanged { get; set; }

    private async Task DeleteParam(QueryStringParameter param)
    {
        Parameters.Remove(param);

        await OnParamDeleted.InvokeAsync(param);
    }

    private async Task AddParam(string key, string value)
    {
        _paramKey = key;
        _paramValue = value;

        if (string.IsNullOrWhiteSpace(_paramKey) || string.IsNullOrWhiteSpace(_paramValue))
            return;

        await OnParamAdded.InvokeAsync(new QueryStringParameter { Key = _paramKey, Value = _paramValue });

        await _paramKeyText.ClearAsync();
        await _paramValueText.ClearAsync();
    }

    private async Task UpdateKey(QueryStringParameter parameter, string key)
    {
        parameter.Key = key;
        await OnParamChanged.InvokeAsync(parameter);
    }

    private async Task UpdateValue(QueryStringParameter parameter, string value)
    {
        parameter.Value = value;
        await OnParamChanged.InvokeAsync(parameter);
    }
}
