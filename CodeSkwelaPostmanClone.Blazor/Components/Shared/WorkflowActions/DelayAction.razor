@using CoreShared = CodeSkwelaPostmanClone.Blazor.Shared

<MudPaper Class="@_moveActionHighlight" Elevation="0">

    <MudStack Row Class="d-flex align-center pa-1">
        <MudNumericField Label="Delay (ms)" @bind-Value="Action.DelayInMilliSeconds"/>

        @if (_isMoving)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Cancel" aria-label="move" OnClick="CancelMoveAction" />
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="delete" OnClick="Delete" />
            <MudIconButton Icon="@Icons.Material.Filled.MoveUp" aria-label="move" OnClick="MoveAction" />
        }
    </MudStack>
</MudPaper>

@code {
    private string? _response;
    private string? _actionName;
    private int _delayMs = 1000;
    private string? _moveActionHighlight;
    private bool _isMoving;

    [Parameter]
    public CoreShared.WorkflowActions.DelayAction? Action { get; set; }
    [Parameter]
    public int DelayInMilliSeconds { get; set; } = 1000;
    [Parameter]
    public EventCallback<string?> OnResponseOutput { get; set; }
    [Parameter]
    public EventCallback<CoreShared.WorkflowAction> OnDelete { get; set; }

    protected override void OnInitialized()
    {
        Action?.OnResponseOutput += DisplayResponse;
    }

    private async Task DisplayResponse(string? response)
    {
        _response = response;
        await OnResponseOutput.InvokeAsync(response);
    }

    private async Task Delete()
    {
        await OnDelete.InvokeAsync(Action);
    }

    private void MoveAction()
    {
        //highlight action
        _moveActionHighlight = "border-solid border-2 mud-border-error";
        _isMoving = true;
    }

    private void CancelMoveAction()
    {
        _moveActionHighlight = string.Empty;
        _isMoving = false;
    }
}
