@using CodeSkwelaPostmanClone.Blazor.Infrastructure.Data
@using CoreShared = CodeSkwelaPostmanClone.Blazor.Shared
@using Microsoft.EntityFrameworkCore
@inject IHttpClientFactory HttpClientFactory
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<MudStack Row Class="d-flex align-center pa-1">
    <MudNumericField Label="Repeat Count" @bind-Value="Action.RepeatCount" />
    <MudMenu Icon="@Icons.Material.Filled.Add" AriaLabel="Open user menu">
        <MudMenuItem Label="Request" OnClick="AddRequest" />
        <MudDivider />
        <MudMenuItem Label="Repeat" OnClick="AddRepeat" />
        <MudMenuItem Label="Delay" OnClick="AddDelay" />
    </MudMenu>
    <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="delete" OnClick="Delete" />
</MudStack>
<MudPaper Elevation="0" Class="pa-2">
    @foreach (var action in Action.ChildActions)
    {
    <MudPaper Class="pa-2" Square="true" Outlined="true" @key="action">
        @if (action is CoreShared.WorkflowActions.DelayAction delayAction)
        {
            <DelayAction Action="delayAction" OnResponseOutput="DisplayResponse" OnDelete="DeleteChildAction" />
        }
        else if (action is CoreShared.WorkflowActions.RepeatAction repeatAction)
        {
            <RepeatAction Action="repeatAction" OnResponseOutput="DisplayResponse" OnDelete="DeleteChildAction" />    
        }
        else
        {
            <WorkflowAction Action="action" OnResponseOutput="DisplayResponse" OnDelete="DeleteChildAction" />
        }
        </MudPaper>
    }
</MudPaper>
<MudMessageBox @ref="_mudMessageBox" Title="Select Request" CancelText="Cancel">
    <MessageContent>
        <MudText>Select a request and click Add to proceed.</MudText>
        <MudList @bind-SelectedValue="_selectedRequest">
            @foreach (var request in _requests)
            {
                <MudListItem Value="request">@request.Name</MudListItem>
            }
        </MudList>
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary">Add</MudButton>
    </YesButton>
</MudMessageBox>

@code {
    MudMessageBox _mudMessageBox;
    Core.Entities.RequestSettings _selectedRequest;
    List<Core.Entities.RequestSettings> _requests = new List<Core.Entities.RequestSettings>();

    [Parameter]
    public CoreShared.WorkflowActions.RepeatAction? Action { get; set; }
    [Parameter]
    public EventCallback<string?> OnResponseOutput { get; set; }
    [Parameter]
    public EventCallback<CoreShared.WorkflowAction> OnDelete { get; set; }

    protected override void OnInitialized()
    {
        Action?.OnResponseOutput += DisplayResponse;
    }

    private async Task DisplayResponse(string? response)
    {
        await OnResponseOutput.InvokeAsync(response);
    }

    private async Task AddDelay()
    {
        var delayAction = new CoreShared.WorkflowActions.DelayAction("Delay 2 seconds", 2000);
        Action?.ChildActions.Add(delayAction);
    }

    private async Task AddRequest()
    {
        await LoadRequests();

        var result = await _mudMessageBox.ShowAsync();

        if (result.HasValue && result.Value)
        {
            var requestWorkflowAction = new CoreShared.WorkflowActions.RequestAction(_selectedRequest.Name, _selectedRequest, HttpClientFactory.CreateClient());
            Action?.ChildActions.Add(requestWorkflowAction);
        }
    }

    private async Task LoadRequests()
    {
        using (var context = DbContextFactory.CreateDbContext())
        {
            _requests = await context.RequestSettings.ToListAsync();
        }
    }

    private void AddRepeat()
    {
        var repeatAction = new CoreShared.WorkflowActions.RepeatAction("Repeat", 1);
        Action?.ChildActions.Add(repeatAction);
    }

    private async Task Delete()
    {
        await OnDelete.InvokeAsync(Action);
    }

    private void DeleteChildAction(CoreShared.WorkflowAction action)
    {
        Action?.ChildActions.Remove(action);
    }
}
